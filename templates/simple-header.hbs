{{!-- A header with no vitals: portrait, name and the edit lock. `header.key` names the sheet's strings
     under ALTSHEET; `header.subtitle` is an optional line beside the name. --}}
<header class="aas-header aas-header-simple">
  {{#if editMode}}
  <img class="aas-portrait editable" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img"
    data-tooltip="{{localize 'ALTSHEET.EditPortrait'}}">
  {{else}}
  <img class="aas-portrait" src="{{actor.img}}" alt="{{actor.name}}">
  {{/if}}

  <div class="aas-identity">
    {{#if editMode}}
    <input class="aas-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'ALIENRPG.Name'}}">
    {{else}}
    <h1 class="aas-name">{{actor.name}}</h1>
    {{/if}}
    {{#unless limited}}{{#if header.subtitle}}
    <div class="aas-career"><span>{{header.subtitle}}</span></div>
    {{/if}}{{/unless}}
  </div>

  {{#if editable}}
  <button type="button" class="aas-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit"
    aria-pressed="{{#if editMode}}true{{else}}false{{/if}}"
    data-tooltip="{{#if editMode}}{{localize (concat 'ALTSHEET.' header.key '.EditModeOn')}}{{else}}{{localize (concat 'ALTSHEET.' header.key '.EditModeOff')}}{{/if}}">
    <i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}" inert></i>
    <span>{{localize 'ALTSHEET.EditMode'}}</span>
  </button>
  {{/if}}

  {{#if limited}}
  <p class="aas-limited">{{localize (concat 'ALTSHEET.' header.key '.Limited')}}</p>
  {{/if}}
</header>
