<section class="tab aas-tab aas-notes {{tab.cssClass}}" data-group="primary" data-tab="notes">
  {{#if editable}}
  <prose-mirror name="system.notes" data-document-uuid="{{item.uuid}}" value="{{system.notes}}" collaborate="true"
    toggled="true">{{{enrichedNotes}}}</prose-mirror>
  {{else}}
  <div class="aas-prose">{{{enrichedNotes}}}</div>
  {{/if}}
</section>
