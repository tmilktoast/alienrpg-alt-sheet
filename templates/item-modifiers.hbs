<section class="tab aas-tab aas-item-modifiers {{tab.cssClass}}" data-group="primary" data-tab="modifiers">
  <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i> {{localize 'ALTSHEET.Item.ModifiersHint'}}</p>

  <div class="aas-columns">
    {{#each modifierGroups}}
    <section class="aas-panel">
      <header class="aas-panel-head">
        <h2>{{label}}</h2>
      </header>
      {{#each rows}}
      <label class="aas-modifier {{#if value}}set{{/if}}">
        <span>{{label}}</span>
        <input type="number" name="{{name}}" value="{{value}}" step="1">
      </label>
      {{/each}}
    </section>
    {{/each}}
  </div>
</section>
