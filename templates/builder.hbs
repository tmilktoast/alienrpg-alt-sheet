{{!-- One attribute or skill being bought: its pips and the buttons to spend or take back a point. --}}
{{#*inline "scoreRow"}}
<div class="aas-builder-score {{#if isKey}}key{{/if}}">
  <span class="aas-builder-score-name">{{label}}{{#if isKey}} <span class="aas-tag">{{localize 'ALTSHEET.Builder.Key'}}</span>{{/if}}{{#if bonus}} <span class="aas-tag">{{localize 'ALTSHEET.Builder.EarlyLife.Bonus'}}</span>{{/if}}</span>
  <span class="aas-pips aas-pips-static">{{#each pips}}<span class="aas-pip {{#if filled}}filled{{/if}}"></span>{{/each}}</span>
  <div class="aas-stepper aas-stepper-small">
    <button type="button" data-action="adjust" data-kind="{{kind}}" data-key="{{key}}" data-step="-1"
      {{#unless canLower}}disabled{{/unless}} aria-label="{{localize 'ALTSHEET.Decrease' name=label}}">
      <i class="fa-solid fa-minus" inert></i>
    </button>
    <b>{{value}}</b>
    <button type="button" data-action="adjust" data-kind="{{kind}}" data-key="{{key}}" data-step="1"
      {{#unless canRaise}}disabled{{/unless}} aria-label="{{localize 'ALTSHEET.Increase' name=label}}">
      <i class="fa-solid fa-plus" inert></i>
    </button>
  </div>
</div>
{{/inline}}

{{!-- One answer to a simple question: the creation method, or one of a life path's. --}}
{{#*inline "answer"}}
<button type="button" class="aas-builder-choice {{#if selected}}active{{/if}}" data-action="pick"
  data-choice="{{choice}}" data-value="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
  <i class="{{icon}}" inert></i>
  <span class="aas-builder-choice-body">
    <b>{{label}}</b>
    {{#if hint}}<span>{{hint}}</span>{{/if}}
  </span>
</button>
{{/inline}}

<div class="aas-builder-frame">
  <nav class="aas-builder-steps" aria-label="{{localize 'ALTSHEET.Builder.StepsLabel'}}">
    {{#each steps}}
    <button type="button" class="aas-builder-step {{#if active}}active{{/if}} {{#if done}}done{{/if}}" data-action="goTo"
      data-step="{{id}}" {{#unless enabled}}disabled{{/unless}} {{#if active}}aria-current="step"{{/if}}>
      <span class="aas-die">{{#if done}}<i class="fa-solid fa-check" inert></i>{{else}}{{number}}{{/if}}</span>
      <span>{{label}}</span>
    </button>
    {{/each}}
  </nav>

  <div class="aas-builder-body">
    {{#if (eq step "method")}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i> {{localize 'ALTSHEET.Builder.MethodHint'}}</p>
    <section class="aas-panel">
      <div class="aas-builder-choices aas-builder-choices-wide">
        {{#each methods}}
        {{> answer choice="method"}}
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if (eq step "commander")}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i> {{localize 'ALTSHEET.Builder.Commander.Hint'}}</p>
    <section class="aas-panel">
      <header class="aas-panel-head"><h2>{{localize 'ALTSHEET.Builder.Commander.Question'}}</h2></header>
      <div class="aas-builder-choices">
        {{#each commander}}
        {{> answer choice="commander"}}
        {{/each}}
      </div>
    </section>
    {{#if ranks}}
    <section class="aas-panel">
      <header class="aas-panel-head"><h2>{{localize 'ALTSHEET.Builder.Commander.RankQuestion'}}</h2></header>
      <div class="aas-builder-choices">
        {{#each ranks}}
        {{> answer choice="rank"}}
        {{/each}}
      </div>
    </section>
    {{/if}}
    {{/if}}

    {{#if (eq step "origin")}}
    <section class="aas-panel">
      <header class="aas-panel-head">
        <h2>{{localize 'ALTSHEET.Origin.Label'}}</h2>
        {{#if origin}}<span class="aas-tag">{{localize 'ALTSHEET.Builder.Origin.Rolled' roll=origin.roll}}</span>{{/if}}
      </header>
      {{#if origin}}
      <dl class="aas-facts">
        <dt>{{localize 'ALTSHEET.Origin.Supernation'}}</dt>
        <dd><b>{{origin.supernation}}</b>{{#if origin.detail}}<br><span class="aas-empty">{{origin.detail}}</span>{{/if}}</dd>
        <dt>{{localize 'ALTSHEET.Origin.SubAffiliation'}}</dt><dd><b>{{origin.subAffiliation}}</b></dd>
        <dt>{{localize 'ALTSHEET.Origin.Home'}}</dt><dd><b>{{origin.home}}</b></dd>
      </dl>
      {{else}}
      <div class="aas-prose">
        <p>{{localize 'ALTSHEET.Builder.Origin.Intro'}}</p>
        <ul>
          <li>{{localize 'ALTSHEET.Builder.Origin.IntroSupernation'}}</li>
          <li>{{localize 'ALTSHEET.Builder.Origin.IntroSubAffiliation'}}</li>
          <li>{{localize 'ALTSHEET.Builder.Origin.IntroHome'}}</li>
        </ul>
        <p>{{localize 'ALTSHEET.Builder.Origin.IntroRoll'}}</p>
      </div>
      {{/if}}
      <div class="aas-builder-roll">
        <button type="button" class="aas-button {{#unless origin}}aas-button-primary{{/unless}}" data-action="rollOrigin">
          <i class="fa-solid fa-dice" inert></i>
          {{#if origin}}{{localize 'ALTSHEET.Builder.Origin.Reroll'}}{{else}}{{localize 'ALTSHEET.Builder.Origin.Roll'}}{{/if}}
        </button>
      </div>
    </section>
    {{/if}}

    {{#if (eq step "earlyLife")}}
    <section class="aas-panel">
      <header class="aas-panel-head">
        <h2>{{localize 'ALTSHEET.EarlyLife'}}</h2>
        {{#if earlyLife.gained}}<span class="aas-tag">+1 {{earlyLife.gained}}</span>{{/if}}
      </header>
      {{#if earlyLife}}
      <dl class="aas-facts aas-facts-stacked">
        {{#each earlyLife.parts}}
        <dt>{{label}}</dt><dd>{{text}}</dd>
        {{/each}}
      </dl>
      {{else}}
      <div class="aas-prose">
        <p>{{localize 'ALTSHEET.Builder.EarlyLife.Intro'}}</p>
        <p>{{localize 'ALTSHEET.Builder.EarlyLife.IntroBackground'}}</p>
        <p>{{localize 'ALTSHEET.Builder.EarlyLife.IntroSkill'}}</p>
        <p><strong>{{localize 'ALTSHEET.Builder.EarlyLife.IntroReroll'}}</strong></p>
        <p>{{localize 'ALTSHEET.Builder.EarlyLife.IntroRoll'}}</p>
      </div>
      {{/if}}
      <div class="aas-builder-roll">
        <button type="button" class="aas-button {{#unless earlyLife}}aas-button-primary{{/unless}}" data-action="rollEarlyLife">
          <i class="fa-solid fa-dice" inert></i>
          {{#if earlyLife}}{{localize 'ALTSHEET.Builder.Origin.Reroll'}}{{else}}{{localize 'ALTSHEET.Builder.EarlyLife.Roll'}}{{/if}}
        </button>
      </div>
    </section>
    {{#if earlyLife.options}}
    <section class="aas-panel">
      <header class="aas-panel-head"><h2>{{localize 'ALTSHEET.Builder.EarlyLife.SkillQuestion'}}</h2></header>
      <div class="aas-builder-choices">
        {{#each earlyLife.options}}
        {{> answer choice="earlyLifeSkill"}}
        {{/each}}
      </div>
    </section>
    {{/if}}
    {{/if}}

    {{#if (eq step "joining")}}
    <section class="aas-panel">
      <header class="aas-panel-head">
        <h2>{{localize 'ALTSHEET.Joining'}}</h2>
        {{#if joining.rolled}}<span class="aas-tag">{{localize 'ALTSHEET.Builder.Origin.Rolled' roll=joining.rolled}}</span>{{/if}}
      </header>
      {{#if joining.reasons.length}}
      <div class="aas-prose">
        <p>{{localize 'ALTSHEET.Builder.Joining.Intro'}}</p>
        <p>{{localize 'ALTSHEET.Builder.Joining.IntroPick'}}</p>
      </div>
      <div class="aas-builder-choices aas-builder-choices-wide">
        {{#each joining.reasons}}
        {{> answer choice="joining"}}
        {{/each}}
      </div>
      <div class="aas-builder-roll">
        <button type="button" class="aas-button" data-action="rollJoining">
          <i class="fa-solid fa-dice" inert></i>
          {{localize 'ALTSHEET.Builder.Joining.Roll'}}
        </button>
      </div>
      {{else}}
      <p class="aas-empty">{{localize 'ALTSHEET.Builder.Joining.NoTable'}}</p>
      {{/if}}
    </section>
    {{/if}}

    {{#if (eq step "career")}}
    {{#if isLifePath}}
    <section class="aas-panel">
      <header class="aas-panel-head"><h2>{{localize 'ALTSHEET.Builder.Mos.Title'}}</h2></header>
      <div class="aas-prose">
        <p>{{localize 'ALTSHEET.Builder.Mos.Intro'}}</p>
        <p>{{{localize 'ALTSHEET.Builder.Mos.IntroLimits' attribute=rules.keyAttributeMax skill=rules.keySkillMax}}}</p>
        <p>{{{localize 'ALTSHEET.Builder.Mos.IntroTalents'}}}</p>
        <p>{{localize 'ALTSHEET.Builder.Mos.IntroGear'}}</p>
        <p>{{localize 'ALTSHEET.Builder.Mos.IntroPick'}}</p>
      </div>
    </section>
    {{else}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i> {{localize 'ALTSHEET.Builder.CareerHint'}}</p>
    {{/if}}
    {{#each groups}}
    <section class="aas-panel">
      {{#if name}}<header class="aas-panel-head"><h2>{{name}}</h2></header>{{/if}}
      <div class="aas-builder-choices">
        {{#each careers}}
        <button type="button" class="aas-builder-choice {{#if selected}}active{{/if}}" data-action="pickCareer"
          data-career-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
          <img src="{{img}}" alt="">
          <span class="aas-builder-choice-body">
            <b>{{name}}</b>
            <span class="aas-stats">
              <span>{{localize 'ALTSHEET.Builder.KeyAttribute'}} <b>{{attributeLabel}}</b></span>
              <span>{{localize 'ALTSHEET.Builder.KeySkills'}} <b>{{skillLabels}}</b></span>
            </span>
          </span>
        </button>
        {{/each}}
      </div>
    </section>
    {{else}}
    <p class="aas-empty">{{#if isLifePath}}{{localize 'ALTSHEET.Builder.Mos.None'}}{{else}}{{localize 'ALTSHEET.Builder.NoCareers'}}{{/if}}</p>
    {{/each}}
    {{#if career.description}}
    <section class="aas-panel">
      <header class="aas-panel-head"><h2>{{career.name}}</h2></header>
      <div class="aas-prose">{{{career.description}}}</div>
    </section>
    {{/if}}
    {{/if}}

    {{#if (eq step "attributes")}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i>
      {{localize 'ALTSHEET.Builder.AttributesHint' points=rules.attributePoints min=rules.attributeMin max=rules.attributeMax keyMax=rules.keyAttributeMax key=career.attributeLabel}}</p>
    <section class="aas-panel">
      <header class="aas-panel-head">
        <h2>{{localize 'ALIENRPG.Attributes'}}</h2>
        <span class="aas-tag {{#if attributes.left}}aas-tag-warn{{/if}}">{{localize 'ALTSHEET.Builder.PointsLeft' left=attributes.left}}</span>
      </header>
      {{#each attributes.rows}}
      {{> scoreRow}}
      {{/each}}
    </section>
    {{/if}}

    {{#if (eq step "skills")}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i>
      {{localize 'ALTSHEET.Builder.SkillsHint' points=rules.skillPoints max=rules.skillMax keyMax=rules.keySkillMax keys=career.skillLabels}}
      {{#if bonusSkill}}{{localize 'ALTSHEET.Builder.EarlyLife.Counts' skill=bonusSkill}}{{/if}}</p>
    <section class="aas-panel">
      <header class="aas-panel-head">
        <h2>{{localize 'ALIENRPG.Skills'}}</h2>
        <span class="aas-tag {{#if skills.left}}aas-tag-warn{{/if}}">{{localize 'ALTSHEET.Builder.PointsLeft' left=skills.left}}</span>
      </header>
      {{#each skills.groups}}
      <h3>{{label}}</h3>
      {{#each rows}}
      {{> scoreRow}}
      {{/each}}
      {{/each}}
    </section>
    {{/if}}

    {{#if (eq step "talent")}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i> {{localize 'ALTSHEET.Builder.TalentHint' career=career.name}}</p>
    <section class="aas-panel">
      <div class="aas-builder-choices aas-builder-choices-wide">
        {{#each talents}}
        <button type="button" class="aas-builder-choice {{#if selected}}active{{/if}}" data-action="pickTalent"
          data-talent="{{name}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
          <img src="{{img}}" alt="">
          <span class="aas-builder-choice-body">
            <b>{{name}}</b>
            {{#if missing}}
            <span class="aas-empty">{{localize 'ALTSHEET.Builder.TalentNotInWorld'}}</span>
            {{else}}
            <span class="aas-prose">{{{description}}}</span>
            {{/if}}
          </span>
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if (eq step "review")}}
    <p class="aas-hint"><i class="fa-solid fa-circle-info" inert></i> {{localize 'ALTSHEET.Builder.ReviewHint'}}</p>
    <section class="aas-panel">
      <dl class="aas-facts">
        <dt>{{#if isLifePath}}{{localize 'ALTSHEET.Builder.Steps.mos'}}{{else}}{{localize 'ALIENRPG.Career'}}{{/if}}</dt><dd>{{career.name}}</dd>
        {{#if review.rank}}<dt>{{localize 'ALTSHEET.MilitaryRank'}}</dt><dd>{{review.rank}}</dd>{{/if}}
        {{#if review.origin}}
        <dt>{{localize 'ALTSHEET.Origin.Label'}}</dt>
        <dd>{{review.origin.supernation}}, {{review.origin.subAffiliation}}, {{review.origin.home}}</dd>
        {{/if}}
        {{#if review.earlyLife}}<dt>{{localize 'ALTSHEET.EarlyLife'}}</dt><dd>{{review.earlyLife}}</dd>{{/if}}
        {{#if review.joining}}<dt>{{localize 'ALTSHEET.Joining'}}</dt><dd>{{review.joining}}</dd>{{/if}}
        <dt>{{localize 'ALIENRPG.Attributes'}}</dt>
        <dd>{{#each review.attributes}}<span class="aas-builder-pair">{{label}} <b>{{value}}</b></span>{{/each}}</dd>
        <dt>{{localize 'ALIENRPG.Skills'}}</dt>
        <dd>{{#each review.skills}}<span class="aas-builder-pair">{{label}} <b>{{value}}</b></span>{{/each}}</dd>
        <dt>{{localize 'ALTSHEET.Builder.Steps.talent'}}</dt><dd>{{review.talent}}</dd>
      </dl>
    </section>
    {{#if review.replaces}}
    <p class="aas-hint aas-danger"><i class="fa-solid fa-triangle-exclamation" inert></i> {{localize 'ALTSHEET.Builder.ReplaceNote'}}</p>
    {{/if}}
    {{/if}}
  </div>

  <footer class="aas-builder-footer">
    <button type="button" class="aas-button" data-action="back" {{#if isFirst}}disabled{{/if}}>
      <i class="fa-solid fa-arrow-left" inert></i> {{localize 'ALTSHEET.Builder.Back'}}
    </button>
    {{#if isLast}}
    <button type="button" class="aas-button aas-button-primary" data-action="apply">
      <i class="fa-solid fa-check" inert></i> {{localize 'ALTSHEET.Builder.Apply'}}
    </button>
    {{else}}
    <button type="button" class="aas-button aas-button-primary" data-action="next" {{#unless canNext}}disabled{{/unless}}>
      {{localize 'ALTSHEET.Builder.Next'}} <i class="fa-solid fa-arrow-right" inert></i>
    </button>
    {{/if}}
  </footer>
</div>
