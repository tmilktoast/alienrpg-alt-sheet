<header class="aas-header">
  {{#if editMode}}
  <img class="aas-portrait editable" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img"
    data-tooltip="{{localize 'ALTSHEET.EditPortrait'}}">
  {{else}}
  <img class="aas-portrait aas-portrait-view" src="{{actor.img}}" alt="{{actor.name}}" data-action="showImage"
    data-tooltip="{{localize 'ALTSHEET.Spacecraft.ShowImage'}}">
  {{/if}}

  <div class="aas-identity">
    {{#if editMode}}
    <input class="aas-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'ALIENRPG.Name'}}">
    {{else}}
    <h1 class="aas-name">{{actor.name}}</h1>
    {{/if}}
    {{#unless limited}}{{#if system.attributes.model}}
    <div class="aas-career"><span>{{system.attributes.model}}</span></div>
    {{/if}}{{/unless}}
  </div>

  {{#if editable}}
  <button type="button" class="aas-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit"
    aria-pressed="{{#if editMode}}true{{else}}false{{/if}}"
    data-tooltip="{{#if editMode}}{{localize 'ALTSHEET.Spacecraft.EditModeOn'}}{{else}}{{localize 'ALTSHEET.Spacecraft.EditModeOff'}}{{/if}}">
    <i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}" inert></i>
    <span>{{localize 'ALTSHEET.EditMode'}}</span>
  </button>
  {{/if}}

  {{#if limited}}
  <p class="aas-limited">{{localize 'ALTSHEET.Spacecraft.Limited'}}</p>
  {{else}}
  <div class="aas-vitals">
    <div class="aas-vital {{vitals.damage.cls}}" data-tooltip="{{localize 'ALTSHEET.Spacecraft.DamageHint'}}">
      <span class="aas-vital-label">{{localize 'ALTSHEET.Spacecraft.Damage'}}</span>
      <div class="aas-stepper">
        <button type="button" data-action="stepField" data-path="system.attributes.damage.value" data-step="-1" data-min="0"
          aria-label="{{localize 'ALTSHEET.Decrease' name=(localize 'ALTSHEET.Spacecraft.Damage')}}">
          <i class="fa-solid fa-minus" inert></i>
        </button>
        <span class="aas-vital-value"><b>{{vitals.damage.value}}</b> / {{vitals.damage.max}}</span>
        {{#if editMode}}
        <label class="aas-inline-edit">
          <span>{{localize 'ALTSHEET.Spacecraft.Hull'}}</span>
          <input type="number" name="system.attributes.hull.value" value="{{vitals.damage.max}}" min="0" step="1">
        </label>
        {{/if}}
        <button type="button" data-action="stepField" data-path="system.attributes.damage.value" data-step="1" data-min="0"
          data-max="{{vitals.damage.max}}"
          aria-label="{{localize 'ALTSHEET.Increase' name=(localize 'ALTSHEET.Spacecraft.Damage')}}">
          <i class="fa-solid fa-plus" inert></i>
        </button>
      </div>
      <div class="aas-meter"><span style="width: {{vitals.damage.pct}}%"></span></div>
    </div>

    <div class="aas-vital aas-vital-compact">
      <span class="aas-vital-label">{{localize 'ALIENRPG.Armor'}}</span>
      {{#if editMode}}
      <label class="aas-inline-edit">
        <input type="number" name="system.attributes.armor.value" value="{{vitals.armor.value}}" min="0" step="1"
          aria-label="{{localize 'ALIENRPG.Armor'}}">
      </label>
      {{else}}
      <div class="aas-rollgroup">
        <button type="button" class="aas-roll" data-action="roll" data-roll-type="ability" data-spbutt="armor"
          data-roll="{{vitals.armor.value}}" data-label="{{localize 'ALIENRPG.Armor'}}"
          data-tooltip="{{localize 'ALTSHEET.ArmorRoll'}}" {{#unless vitals.armor.rollable}}disabled{{/unless}}>
          <span class="aas-die">{{vitals.armor.value}}</span>
        </button>
        <button type="button" class="aas-mods" data-action="rollMods" data-tooltip="{{localize 'ALTSHEET.RollWithMods'}}"
          aria-label="{{localize 'ALTSHEET.RollWithMods'}}" {{#unless vitals.armor.rollable}}disabled{{/unless}}>
          <i class="fa-solid fa-sliders" inert></i>
        </button>
      </div>
      {{/if}}
    </div>

    <div class="aas-vital aas-vital-compact" data-tooltip="{{localize 'ALTSHEET.Spacecraft.ThrustersHint'}}">
      <span class="aas-vital-label">{{localize 'ALTSHEET.Spacecraft.Thrusters'}}</span>
      {{#if editMode}}
      <label class="aas-inline-edit">
        <input type="number" name="system.attributes.thrusters.value" value="{{system.attributes.thrusters.value}}"
          step="1" aria-label="{{localize 'ALTSHEET.Spacecraft.Thrusters'}}">
      </label>
      {{else}}
      <span class="aas-vital-value aas-vital-big"><b>{{vitals.thrusters}}</b></span>
      {{/if}}
    </div>

    <div class="aas-vital aas-vital-compact">
      <span class="aas-vital-label">{{localize 'ALTSHEET.Spacecraft.Signature'}}</span>
      {{#if editMode}}
      <label class="aas-inline-edit">
        <input type="number" name="system.attributes.signature.value" value="{{system.attributes.signature.value}}"
          step="1" aria-label="{{localize 'ALTSHEET.Spacecraft.Signature'}}">
      </label>
      {{else}}
      <span class="aas-vital-value aas-vital-big"><b>{{vitals.signature}}</b></span>
      {{/if}}
    </div>
  </div>
  {{/if}}
</header>
